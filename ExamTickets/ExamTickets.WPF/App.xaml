<Application x:Class="ExamTickets.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Цвета и базовая тема -->
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime"
                                             ColorAdjustment="{materialDesign:ColorAdjustment}" />

                <!-- 2. ГЛАВНОЕ: Стили всех контролов (кнопок, полей и т.д.) -->
                <!-- В версии 5.x используйте именно этот путь: -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 3. Глобальный стиль (чтобы не прописывать Style у каждой кнопки) -->
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
