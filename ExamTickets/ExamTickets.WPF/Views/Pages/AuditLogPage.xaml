<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="ExamTickets.WPF.Views.Pages.AuditLogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Журнал аудита">

    <Grid Margin="16" Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Пользователь:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="200"
                     Text="{Binding UserSearch, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0" />

            <TextBlock Text="Действие:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox Width="200"
                     Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0" />

            <TextBlock Text="С:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <DatePicker SelectedDate="{Binding DateFrom}" Margin="0,0,8,0" />

            <Button Content="Обновить" Command="{Binding LoadLogsCommand}" Margin="0,0,8,0" />
            <Button Content="Экспорт CSV" Command="{Binding ExportToCsvCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Logs}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding User.FullName}" Width="200" />
                <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="200" />
                <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="*" />
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
