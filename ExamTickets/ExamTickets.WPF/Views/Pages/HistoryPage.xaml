<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="ExamTickets.WPF.Views.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="История">

    <Grid Margin="16" Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Специальность:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox Width="220"
                      ItemsSource="{Binding Specialties}"
                      DisplayMemberPath="SpecialtyName"
                      SelectedItem="{Binding SelectedSpecialty}"
                      Margin="0,0,8,0" />

            <TextBox Width="220"
                     Text="{Binding SubjectSearch, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0" />

            <TextBlock Text="С:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <DatePicker SelectedDate="{Binding DateFrom}" Margin="0,0,8,0" />

            <TextBlock Text="По:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <DatePicker SelectedDate="{Binding DateTo}" Margin="0,0,8,0" />

            <Button Content="Обновить" Command="{Binding LoadEventsCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Events}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Subject.SubjectName}" Width="*" />
                <DataGridTextColumn Header="Специальность" Binding="{Binding Specialty.SpecialtyName}" Width="180" />
                <DataGridTextColumn Header="Группа" Binding="{Binding Group.GroupNumber}" Width="120" />
                <DataGridTextColumn Header="Учитель" Binding="{Binding Teacher.FullName}" Width="180" />
                <DataGridTextColumn Header="Дата" Binding="{Binding ExamDate, StringFormat=dd.MM.yyyy}" Width="120" />
                <DataGridTextColumn Header="Билетов" Binding="{Binding TicketCount}" Width="80" />
                <DataGridTextColumn Header="Создатель" Binding="{Binding CreatedByUser.FullName}" Width="180" />
                <DataGridTemplateColumn Header="Действия" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Открыть docx"
                                        Command="{Binding DataContext.OpenDocxCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,8,0" />
                                <Button Content="Открыть PDF"
                                        Command="{Binding DataContext.OpenPdfCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,8,0" />
                                <Button Content="Удалить"
                                        Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
